{
  "name": "gaylaxy-maker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run prepare:assets",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run prepare:assets",
    "build": "tsc -b && vite build",
